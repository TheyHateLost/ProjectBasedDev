  m_Script: {fileID: 11500000, guid: 932d76ec03b1969458f0148d520eeab7, type: 3}
  m_Name: Voltage Tester
  m_EditorClassIdentifier: Assembly-CSharp::DiscoveryTextSO
  text: "\u2022 Watch the icon color carefully.\r\nA flashing red icon means the
    thermostat has a problem and needs to be fixed. A flashing green icon means the
    thermostat is working correctly.\r\n\u2022 Do not repair green thermostats.\r\nIf
    the icon flashes green, move on and check another thermostat. The goal is to
    find the problem areas, not waste time on working systems.\r\n\u2022 Red means
    action is needed.\r\nWhen the icon flashes red, interact with the thermostat
    to begin the repair process."
