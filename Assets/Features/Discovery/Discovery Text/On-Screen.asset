  m_Script: {fileID: 11500000, guid: 932d76ec03b1969458f0148d520eeab7, type: 3}
  m_Name: On-Screen
  m_EditorClassIdentifier: Assembly-CSharp::DiscoveryTextSO
  text: "\u2022 Inspect the room for clues.\r\n\u2022 Write down what you notice.\r\n\u2022
    Choose the correct tool.\r\n\u2022 A drafty window may have small gaps letting
    cold air in.\r\n\u2022 A leaking sink may leave clues like rust, water damage,
    or signs of moisture on the cabinet below.\r\n\u2022 Complete the repair carefully.\r\n\u2022
    Accuracy improves progress.\r\n"
